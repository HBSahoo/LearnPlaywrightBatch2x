const obj = { a: 1, b: 2, c: 3 };
console.log(Object.keys(obj)); //[ 'a', 'b', 'c' ]
console.log(Object.values(obj)); //[ 1, 2, 3 ]
console.log(Object.entries(obj));//[ [ 'a', 1 ], [ 'b', 2 ], [ 'c', 3 ] ]----> return key vaulue pair

const user = { name: "John", age: 30, id: 400 };

//itterate the value through for loop

for(const key in user){ // this for loop we are using most of the time
    //capture only Keys
    console.log(key);
    //capture only values
    console.log(user[key]);
    console.log(`${key}: ${user[key]}`);
}

//some alternate loop but we are using in rare case
// // Object.keys/values/entries
Object.keys(user).forEach(key => {
console.log(key);
});

Object.entries(user).forEach(([key, Value]) => {
 console.log(key,Value);
});